      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════ BLACK TICKER -->
    {tickerPosts.length > 0 && (
      <div class="gh-ticker" aria-label="Πρόσφατα κείμενα" role="marquee">
        <div class="gh-ticker__label">ΤΕΛΕΥΤΑΙΑ:</div>
        <div class="gh-ticker__track-wrap">
          <div class="gh-ticker__track">
            <!-- doubled for seamless loop -->
            {[...tickerPosts, ...tickerPosts].map((post: PP) => {
              const s = getPostStatus(post);
              return (
                <a href={`/posts/${post.id}`} class="gh-ticker__item">
                  <span class="gh-ticker__badge" style={`background:${s.hex};`}>{s.label}</span>
                  <span class="gh-ticker__name">{post.data.title}</span>
                  <span class="gh-ticker__dot" aria-hidden="true">◆</span>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    )}

    <!-- ═══════════════════════════════════════════════════════ CARDS GRID -->
    {processedPosts.length > 0 ? (
      <section class="gh-grid-section">
        <div class="gh-section-head">
          <span class="gh-section-label">ΚΕΙΜΕΝΑ</span>
          <a href="/posts" class="gh-section-link">ΟΛΑ →</a>
        </div>

        <div class="gh-cards">
          {processedPosts.slice(0, 6).map((post: PP, i: number) => {
            const s = getPostStatus(post);
            const imgSrc = resolveImageSrc(post);
            const isFeat = i === 0;
            const dateStr = new Date(post.data.date).toLocaleDateString('el-GR', { day: '2-digit', month: '2-digit', year: 'numeric' });
            return (
              <a
                href={`/posts/${post.id}`}
                class={`gh-card${isFeat ? ' gh-card--feat' : ''}`}
                aria-label={post.data.title}
              >
                {imgSrc && (
                  <div class="gh-card__img-wrap">
                    <img
                      src={imgSrc}
                      alt={post.data.imageAlt || post.data.title}
                      class="gh-card__img"
                      loading={i < 2 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                    <div class="gh-card__img-overlay" aria-hidden="true"></div>
                  </div>
                )}
                <div class="gh-card__body">
                  <div class="gh-card__top">
                    <span class="gh-card__badge" style={`background:${s.hex};`}>{s.label}</span>
                    <time class="gh-card__date" datetime={new Date(post.data.date).toISOString()}>{dateStr}</time>
                  </div>
                  <h2 class="gh-card__title">{post.data.title}</h2>
                  {post.data.description && (
                    <p class="gh-card__desc">{post.data.description}</p>
                  )}
                  {post.data.tags && (post.data.tags as string[]).length > 0 && (
                    <div class="gh-card__tags">
                      {(post.data.tags as string[]).slice(0, 3).map((t: string) => (
                        <span class="gh-card__tag">#{t}</span>
                      ))}
                    </div>
                  )}
                </div>
                <div class="gh-card__foot">ΑΝΑΓΝΩΣΗ →</div>
              </a>
            );
          })}
        </div>

        {processedPosts.length > 6 && (
          <div class="gh-more">
            <a href="/posts" class="gh-more__link">+ {processedPosts.length - 6} ακόμα κείμενα</a>
          </div>
        )}
      </section>
    ) : (
      <section class="gh-empty">
        <p>// Δεν υπάρχουν κείμενα ακόμα. Επιστρέψτε σύντομα.</p>
      </section>
    )}

    <!-- ═══════════════════════════════════════════════════════ TAG INDEX -->
    {sortedTags.length > 0 && (
      <section class="gh-index">
        <div class="gh-section-head">
          <span class="gh-section-label">ΕΥΡΕΤΗΡΙΟ / INDEX</span>
        </div>
        <div class="gh-index__grid">
          {sortedTags.map(([tag, posts]) => (
            <div class="gh-index__col">
              <a href={`/posts/tag/${tag}`} class="gh-index__cat">{tag.toUpperCase()}</a>
              <ul class="gh-index__list">
                {(posts as PP[]).map((p: PP, pi: number) => {
                  const isLast = pi === posts.length - 1;
                  return (
                    <li class="gh-index__item">
                      <span class="gh-index__branch">{isLast ? '└──' : '├──'}</span>
                      <a href={`/posts/${p.id}`} class="gh-index__link">{p.data.title}</a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
          {untaggedPosts.length > 0 && (
            <div class="gh-index__col">
              <span class="gh-index__cat">ΑΤΑΞΙΝΟΜΗΤΑ</span>
              <ul class="gh-index__list">
                {(untaggedPosts as PP[]).map((p: PP, pi: number) => {
                  const isLast = pi === untaggedPosts.length - 1;
                  return (
                    <li class="gh-index__item">
                      <span class="gh-index__branch">{isLast ? '└──' : '├──'}</span>
                      <a href={`/posts/${p.id}`} class="gh-index__link">{p.data.title}</a>
                    </li>
                  );
                })}
              </ul>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- ═══════════════════════════════════════════════════════ FOOTER BAR -->
    <footer class="gh-footbar">
      <span>© 2026 {siteConfig.author} — {siteConfig.title}</span>
      <div class="gh-footbar__links">
        <a href="/feed.xml" class="gh-footbar__link">RSS</a>
        <a href="/posts"    class="gh-footbar__link">ΑΡΧΕΙΟ</a>
      </div>
    </footer>

  </div><!-- /#gh -->
</BaseLayout>

<style is:global>
/* ═══════════════════════════════════════════════════
   BREAKOUT: Make homepage fill full viewport width
   overriding BaseLayout's max-width main container
═══════════════════════════════════════════════════ */
body:has(#gh) {
  background-color: #E8DFD0 !important;
}
.dark body:has(#gh),
body.dark:has(#gh) {
  background-color: #1A1E28 !important;
}

#main-content:has(#gh) {
  max-width: 100% !important;
  width: 100% !important;
  padding: 0 !important;
  margin: 0 !important;
}

/* Override sticky header bg on homepage */
body:has(#gh) #main-header {
  background-color: #E8DFD0 !important;
  border-bottom: 1px solid rgba(26,26,26,0.15) !important;
}
body.dark:has(#gh) #main-header,
.dark body:has(#gh) #main-header {
  background-color: #1A1E28 !important;
  border-bottom: 1px solid rgba(255,255,255,0.1) !important;
}

/* ═══════════════════════════════════════════════════
   DESIGN TOKENS
═══════════════════════════════════════════════════ */
#gh {
  --g-bg:      #E8DFD0;
  --g-bg-dark: #1A1E28;
  --g-ink:     #1A1A1A;
  --g-muted:   #5A5248;
  --g-line:    rgba(26,26,26,0.18);
  --g-mono:    'Roboto Mono', 'Courier New', monospace;
  --g-sans:    'Space Grotesk', 'Inter', sans-serif;
  --g-black:   #111010;

  font-family: var(--g-mono);
  background: var(--g-bg);
  color: var(--g-ink);
  width: 100%;
}

.dark #gh {
  --g-bg:    #1A1E28;
  --g-ink:   #E0D8C8;
  --g-muted: #9A9490;
  --g-line:  rgba(255,255,255,0.1);
}

#gh * { box-sizing: border-box; }

/* ═══════════════════════════════════════════════════
   HERO
═══════════════════════════════════════════════════ */
.gh-hero {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 2rem;
  padding: 3rem 3rem 2.5rem;
  border-bottom: 1px solid var(--g-line);
}

.gh-hero__eyebrow {
  font-size: 0.62rem;
  letter-spacing: 0.22em;
  color: var(--g-muted);
  margin: 0 0 1.1rem;
  opacity: 0.75;
}

.gh-hero__title { margin: 0 0 1.4rem; }

.gh-hero__title-big {
  display: block;
  font-family: var(--g-sans);
  font-size: clamp(2.8rem, 6vw, 5.5rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  color: var(--g-ink);
  line-height: 1;
}

.gh-hero__title-sub {
  display: block;
  font-family: var(--g-mono);
  font-size: clamp(0.72rem, 1.4vw, 0.92rem);
  letter-spacing: 0.14em;
  color: var(--g-muted);
  margin-top: 0.7rem;
}

.gh-hero__meta {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  font-family: var(--g-mono);
  font-size: 0.72rem;
  color: var(--g-muted);
}
.gh-sep { opacity: 0.35; }

.gh-hero__cta {
  color: var(--g-ink);
  text-decoration: none;
  font-weight: 600;
  letter-spacing: 0.1em;
  border-bottom: 1px solid currentColor;
  padding-bottom: 1px;
  transition: opacity 0.15s;
}
.gh-hero__cta:hover { opacity: 0.55; }

.gh-hero__deco {
  width: clamp(110px, 13vw, 170px);
  height: clamp(110px, 13vw, 170px);
  opacity: 0.22;
  color: var(--g-ink);
  flex-shrink: 0;
}
.gh-hero__svg {
  width: 100%;
  height: 100%;
}

/* ═══════════════════════════════════════════════════
   BLACK SCROLLING TICKER (hidden by default)
═══════════════════════════════════════════════════ */
.gh-ticker {
  display: flex;
  align-items: stretch;
  background: var(--g-black);
  overflow: hidden;
  border-bottom: 1px solid var(--g-line);
  height: 2.6rem;
}

.gh-ticker__label {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 0 1.1rem;
  font-family: var(--g-mono);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  color: #fff;
  background: #000;
  border-right: 1px solid rgba(255,255,255,0.15);
  white-space: nowrap;
  z-index: 1;
}

.gh-ticker__track-wrap {
  overflow: hidden;
  flex: 1;
  position: relative;
}

.gh-ticker__track-wrap::before,
.gh-ticker__track-wrap::after {
  content: '';
  position: absolute;
  top: 0;
  width: 40px;
  height: 100%;
  z-index: 2;
  pointer-events: none;
}
.gh-ticker__track-wrap::before {
  left: 0;
  background: linear-gradient(to right, var(--g-black), transparent);
}
.gh-ticker__track-wrap::after {
  right: 0;
  background: linear-gradient(to left, var(--g-black), transparent);
}

.gh-ticker__track {
  display: flex;
  align-items: center;
  width: max-content;
  animation: gh-marquee 28s linear infinite;
  gap: 0;
}
.gh-ticker__track:hover { animation-play-state: paused; }

@keyframes gh-marquee {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.gh-ticker__item {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  padding: 0 1.5rem;
  text-decoration: none;
  white-space: nowrap;
  border-right: 1px solid rgba(255,255,255,0.08);
  height: 2.6rem;
  transition: background 0.15s;
}
.gh-ticker__item:hover { background: rgba(255,255,255,0.06); }

.gh-ticker__badge {
  display: none; /* Hide ΝΕΟ/ΕΝΕΡΓΟ badge inside ticker */
}

.gh-ticker__name {
  font-family: var(--g-mono);
  font-size: 0.73rem;
  color: rgba(255,255,255,0.82);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.gh-ticker__dot {
  font-size: 0.4rem;
  color: rgba(255,255,255,0.2);
  margin-left: 0.4rem;
}

/* ═══════════════════════════════════════════════════
   SECTION HEADERS
═══════════════════════════════════════════════════ */
.gh-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.85rem 3rem;
  border-bottom: 1px solid var(--g-line);
  background: rgba(0,0,0,0.025);
}
.dark .gh-section-head { background: rgba(255,255,255,0.025); }

.gh-section-label {
  font-family: var(--g-mono);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  color: var(--g-muted);
  text-transform: uppercase;
}

.gh-section-link {
  font-family: var(--g-mono);
  font-size: 0.68rem;
  letter-spacing: 0.12em;
  color: var(--g-ink);
  text-decoration: none;
  border-bottom: 1px solid currentColor;
  transition: opacity 0.15s;
}
.gh-section-link:hover { opacity: 0.55; }

/* ═══════════════════════════════════════════════════
   CARDS
═══════════════════════════════════════════════════ */
.gh-grid-section { border-bottom: 1px solid var(--g-line); }

.gh-cards {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
}

@media (max-width: 1200px) { .gh-cards { grid-template-columns: repeat(4, 1fr); } }
